<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self Stream Deck installer (WiX 3.14). Built by agent/scripts/msi/build-msi.ps1:
    candle -dVersion=0.1.0 -dExe=...\ssd.exe -dScripts=...\scripts ssd.wxs   then   light ssd.wixobj

  What it does: copies ssd.exe and its helper scripts into Program Files\Self Stream Deck, makes a Start Menu shortcut, registers the
  "Self Stream Deck" scheduled task (starts at logon, hidden, as administrator) and starts it. Uninstalling removes the task, the
  firewall rules and the files; %APPDATA%\SelfStreamDeck (the pairing token and the certificates) stays.

  Public properties:  MIGRATEFROM="C:\old\data"   copies config.json and tls\ from an earlier install (the phone stays paired)
                      NOSTART=1                    registers the task without starting it
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Self Stream Deck" Language="1046" Codepage="1252" Version="$(var.Version)"
           Manufacturer="Self Stream Deck" UpgradeCode="6B1E5F0A-2C47-4D8B-9A63-5E7D1F3C8A21">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="Self Stream Deck: o celular como painel de controle do PC" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Uma versão mais nova do Self Stream Deck já está instalada." />

    <Property Id="MIGRATEFROM" Secure="yes" />
    <Property Id="NOSTART" Secure="yes" />
    <Icon Id="ssd.ico" SourceFile="$(var.Exe)" />
    <Property Id="ARPPRODUCTICON" Value="ssd.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Self Stream Deck" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AgentExe" Guid="*" Win64="yes">
        <File Id="ssd.exe" Source="$(var.Exe)" KeyPath="yes" />
      </Component>
      <Component Id="Launcher" Guid="*" Win64="yes">
        <File Id="launch_hidden.vbs" Source="$(var.Scripts)\launch-hidden.vbs" KeyPath="yes" />
      </Component>
      <Component Id="TaskRegister" Guid="*" Win64="yes">
        <File Id="task_register.ps1" Source="$(var.Scripts)\msi\task-register.ps1" KeyPath="yes" />
      </Component>
      <Component Id="TaskRemove" Guid="*" Win64="yes">
        <File Id="task_remove.ps1" Source="$(var.Scripts)\msi\task-remove.ps1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="StartShortcut" Name="Self Stream Deck" Description="Inicia o agente do Self Stream Deck"
                  Target="[SystemFolder]wscript.exe" Arguments="//B //Nologo &quot;[INSTALLFOLDER]launch-hidden.vbs&quot; &quot;[INSTALLFOLDER]ssd.exe&quot; &quot;[%APPDATA]\SelfStreamDeck&quot;"
                  WorkingDirectory="INSTALLFOLDER" Icon="ssd.ico" />
        <RegistryValue Root="HKCU" Key="Software\SelfStreamDeck" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Self Stream Deck" Level="1">
      <ComponentRef Id="AgentExe" />
      <ComponentRef Id="Launcher" />
      <ComponentRef Id="TaskRegister" />
      <ComponentRef Id="TaskRemove" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- The deferred actions run as SYSTEM, so what they need from the installing user (name, %APPDATA%) goes on the command line,
         which the immediate "Set" actions build (a deferred action reads its command line from the property named like itself). -->
    <CustomAction Id="RegisterTask.Cmd" Property="RegisterTask"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]task-register.ps1&quot; -Data &quot;[%APPDATA]\SelfStreamDeck&quot; -User &quot;[%USERDOMAIN]\[%USERNAME]&quot; -From &quot;[MIGRATEFROM]&quot; -NoStart &quot;[NOSTART]&quot;" />
    <CustomAction Id="RegisterTask" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no" />
    <CustomAction Id="RemoveTask.Cmd" Property="RemoveTask"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]task-remove.ps1&quot;" />
    <CustomAction Id="RemoveTask" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="no" />

    <InstallExecuteSequence>
      <!-- stop what is running before its files are replaced or removed (on an upgrade too) -->
      <Custom Action="RemoveTask.Cmd" After="InstallInitialize">1</Custom>
      <Custom Action="RemoveTask" After="RemoveTask.Cmd">1</Custom>
      <Custom Action="RegisterTask.Cmd" After="InstallFiles">NOT (REMOVE~="ALL")</Custom>
      <Custom Action="RegisterTask" After="RegisterTask.Cmd">NOT (REMOVE~="ALL")</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
