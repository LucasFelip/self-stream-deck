# Workflow pronto e DESLIGADO (docs/adr/0006). Para ligar: copiar para .github/workflows/check.yml.
name: check
on:
  push: { branches: [main] }
  pull_request:
jobs:
  check:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version-file: .nvmrc, cache: npm, cache-dependency-path: '**/package-lock.json' }
      - run: node tools/check.js --ci
